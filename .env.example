# SpatialDesk AI - environment variables (server side only; never shipped to the browser)
# Copy to .env and fill in real values. .env is git-ignored.

# Port the Node server (static files + /api) listens on. Default 8787.
PORT=8787

# Anthropic API key used by the AI assistant proxy. Leave empty to run with the
# assistant in its "not configured" state. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model used by the assistant. Default is claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# Upper bound on assistant requests per minute per client IP. Default 20.
AI_RATE_LIMIT_PER_MINUTE=20

# Comma separated list of origins allowed to call /api when the app is served
# from a different origin (e.g. a Vite dev server). Same-origin is always allowed.
ALLOWED_ORIGINS=https://localhost:8081

# Set to "false" to run the Vite dev server over plain HTTP (localhost only).
SPATIALDESK_DEV_HTTPS=true

# Number of trusted reverse-proxy hops in front of the server (Render, Fly, nginx: 1).
# Leave empty/0 when clients connect directly. Controls which X-Forwarded-For
# entry the AI rate limiter uses, so clients cannot spoof it.
TRUST_PROXY=0
