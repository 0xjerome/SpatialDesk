{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@iwsdk/vite-plugin-dev/client", "vite/client", "@types/webxr", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/unit/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
