{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/workspace.iwsdk.scene.json",
  "assets": { "module": "./src/xr/assets" },
  "components": { "module": "./src/xr/components" },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "none",
      "referenceSpace": { "type": "local-floor", "fallbackOrder": ["local", "viewer"] },
      "restoreCameraOnExit": true,
      "launchOnSessionGranted": true,
      "features": {
        "handTracking": true,
        "layers": true,
        "anchors": false,
        "hitTest": false
      }
    },
    "input": { "canvasPointerEvents": true },
    "render": {
      "near": 0.01,
      "far": 100,
      "camera": { "position": [0, 1.55, 0.4], "lookAt": [0, 1.4, -1.2] }
    },
    "features": {
      "locomotion": false,
      "grabbing": { "useHandPinchForGrab": true },
      "physics": false,
      "sceneUnderstanding": false,
      "environmentRaycast": false,
      "spatialUI": { "kit": "horizon", "preferredColorScheme": "dark" }
    }
  },
  "dev": {
    "emulator": { "device": "metaQuest3" }
  }
}
